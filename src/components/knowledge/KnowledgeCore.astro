---
import { topics } from '../../data/topics';
import { type Locale } from '../../lib/i18n';
import TopicLink from './TopicLink.vue';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="library-list">
  <ul>
    {topics.map((topic) => (
      <li data-topic-row>
        <TopicLink topic={topic} locale={locale} />
      </li>
    ))}
  </ul>
</div>
