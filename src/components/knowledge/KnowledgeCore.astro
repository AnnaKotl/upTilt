---
import { topics } from '../../data/topics';
import { pageUrl, type Locale } from '../../lib/i18n';
import Icon from '../ui/Icon.vue';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<div class="library-list">
  <ul>
    {topics.map((topic) => (
      <li data-topic-row>
        <a class="topic-row" href={pageUrl(locale, 'knowledge/' + topic.id)}>
          <Icon name={topic.icon} />
          <span>
            <strong>
              {topic.title[locale]} <Icon name="forward" />
            </strong>
            <small>{topic.summary[locale]}</small>
          </span>
        </a>
      </li>
    ))}
  </ul>
</div>
