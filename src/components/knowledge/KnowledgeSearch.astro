---
import ActionLabel from '../ui/ActionLabel.vue';
import Icon from '../ui/Icon.vue';
import { pageUrl, type Locale } from '../../lib/i18n';
const { locale } = Astro.props as { locale: Locale };
const uk = locale === 'uk';
const label = uk ? 'Пошук' : 'Search';
---

<div class="library-search" data-library-search>
  <div class="search-shade" aria-hidden="true"></div>
  <button
    type="button"
    class="edge-tab"
    data-search-toggle
    aria-label={label}
    aria-expanded="false"
    aria-controls="knowledge-search"
  >
    <Icon name="search" />
    <ActionLabel text={label} />
  </button>
  <form
    inert
    id="knowledge-search"
    role="search"
    method="get"
    action={pageUrl(locale, 'knowledge/search')}
  >
    <input
      type="search"
      aria-label={label}
      name="q"
      required
      enterkeyhint="search"
      autocomplete="off"
    />
    <button
      type="button"
      data-search-clear
      hidden
      aria-label={uk ? 'Очистити пошук' : 'Clear search'}
    >
      <Icon name="close" />
    </button>
  </form>
</div>

<script>
  const search = document.querySelector<HTMLElement>('[data-library-search]');
  if (search) {
    const toggle = search.querySelector<HTMLButtonElement>(
      '[data-search-toggle]',
    )!;
    const form = search.querySelector('form')!;
    const input = form.querySelector('input')!;
    const clear = form.querySelector<HTMLButtonElement>('[data-search-clear]')!;
    function setOpen(open: boolean) {
      search!.toggleAttribute('data-open', open);
      form.inert = !open;
      toggle.setAttribute('aria-expanded', String(open));
      if (open) input.focus({ preventScroll: true });
    }
    // Keep search in the reading area when the primary rail becomes a phone dock.
    const rail = search.parentElement!;
    const reading = document.querySelector('.reading-page');
    const compact = matchMedia('(max-width: 760px)');
    function placeSearch() {
      setOpen(false);
      if (compact.matches && reading) reading.prepend(search!);
      else rail.append(search!);
    }
    compact.addEventListener('change', placeSearch);
    placeSearch();
    toggle.addEventListener('click', () => setOpen(form.inert));
    search.querySelector('.search-shade')!.addEventListener('click', () => {
      setOpen(false);
      toggle.focus({ preventScroll: true });
    });
    window.addEventListener('pagehide', () => setOpen(false));
    // Keep the drawer open while a pointer activates one of its buttons.
    search.addEventListener('mousedown', (event) => {
      if (!form.inert && (event.target as Element).closest('button'))
        event.preventDefault();
    });
    search.addEventListener('focusout', (event) => {
      if (!search.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    document.addEventListener('pointerdown', (event) => {
      if (!search.contains(event.target as Node)) setOpen(false);
    });
    search.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || form.inert) return;
      event.preventDefault();
      toggle.focus();
      setOpen(false);
    });
    input.addEventListener(
      'input',
      () => (clear.hidden = input.value.length === 0),
    );
    clear.addEventListener('click', () => {
      input.value = '';
      input.focus();
      clear.hidden = true;
    });
    if (location.pathname.endsWith('/knowledge/search/')) {
      input.value = new URLSearchParams(location.search).get('q') ?? '';
      clear.hidden = !input.value;
      if (!input.value) setOpen(true);
    }
  }
</script>
