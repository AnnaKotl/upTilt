---
const { caption } = Astro.props as { caption: string };
---

<figure class="wave-figure">
  <svg viewBox="0 0 480 145" fill="none" aria-hidden="true">
    <path
      d="M20 89H460M80 30v64m160-64v64"
      stroke="var(--line)"
      stroke-dasharray="3 5"
    />
    <path
      d="M40 89q40-92 80 0t80 0t80 0t80 0t80 0"
      stroke="var(--accent)"
      stroke-width="2.5"
    />
    <path d="M80 30h160m-153-4-7 4 7 4m146-8 7 4-7 4" stroke="currentColor" />
    <text x="160" y="23" text-anchor="middle" fill="currentColor">
      λ
    </text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
<style>
  .wave-figure {
    max-width: 36rem;
    padding: 1rem;
    border-block: 1px solid var(--line);
  }
  .wave-figure svg {
    width: 100%;
    height: auto;
  }
  .wave-figure figcaption {
    font: 0.85rem/1.7 var(--font-mono);
    color: var(--muted);
  }
</style>
