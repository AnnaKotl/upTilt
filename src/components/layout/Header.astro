---
import Icon from '../ui/Icon.vue';
import KnowledgeSearch from '../knowledge/KnowledgeSearch.astro';
import ThemeToggle from '../preferences/ThemeToggle.vue';
import { pageUrl, t, type Locale } from '../../lib/i18n';
interface Props {
  locale: Locale;
  path?: string;
}
const { locale, path = '' } = Astro.props;
const alt = locale === 'uk' ? 'en' : 'uk';
const languageLabel =
  alt === 'en' ? 'Switch to English' : 'Перейти на українську';
const text = t(locale);
const models = [
  { id: 'whoop', icon: 'quad', name: 'Whoop' },
  {
    id: 'seven',
    icon: 'openFrame',
    name: locale === 'uk' ? 'Карбонова рама · 7″' : 'Open frame · 7″',
  },
] as const;
---

<nav
  class="edge-rail"
  aria-label={
    locale === 'uk'
      ? 'Мова, тема й навігація'
      : 'Language, theme and navigation'
  }
>
  <a
    data-language
    class="edge-tab"
    href={pageUrl(alt, path)}
    hreflang={alt}
    lang={alt}
    aria-label={languageLabel}
  >
    <b class="font-mono text-xs">{alt.toUpperCase()}</b>
    <span class="hint">{languageLabel}</span>
  </a>
  <ThemeToggle client:load locale={locale} />
  {!path && (
    <div class="aircraft-picker">
      <button
        class="edge-tab"
        data-model-menu
        aria-expanded="false"
        aria-controls="aircraft-options"
        aria-label={locale === 'uk' ? 'Вибрати коптер' : 'Choose aircraft'}
      >
        <Icon name="quad" />
        <span class="hint">
          {locale === 'uk' ? 'Вибрати коптер' : 'Choose aircraft'}
        </span>
      </button>
      <div id="aircraft-options" inert>
        <div class="model-rows">
          {models.map((item) => (
            <button
              class="edge-tab model-row"
              type="button"
              data-aircraft-option={item.id}
              aria-label={item.name}
              aria-pressed={item.id === 'whoop'}
              disabled={item.id === 'whoop'}
            >
              <Icon name={item.icon} />
              <span class="hint">{item.name}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  )}
  {path && (
    <a
      class="edge-tab"
      data-home
      href={pageUrl(locale)}
      aria-label={locale === 'uk' ? 'На головну сторінку' : 'Home page'}
    >
      <Icon name="quad" />
      <span class="hint">
        {locale === 'uk' ? 'На головну сторінку' : 'Home page'}
      </span>
    </a>
  )}
  <a
    class="edge-tab"
    data-library
    hidden={!path || path === 'knowledge'}
    aria-label={text.knowledge}
    href={pageUrl(locale, 'knowledge')}
  >
    <Icon name="book" />
    <span class="hint">{text.knowledge}</span>
  </a>
  {path === 'knowledge' && <KnowledgeSearch locale={locale} />}
  {!path && (
    <button
      type="button"
      class="edge-tab"
      data-tour
      hidden
      aria-pressed="false"
    >
      <Icon name="replay" />
      <span class="hint">
        {locale === 'uk' ? 'Повторити демонстрацію' : 'Replay the tour'}
      </span>
    </button>
  )}
</nav>
{!path && (
  <a
    class="edge-tab author-tab"
    data-author
    hidden
    href="https://github.com/AnnaKotl/upTilt"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Icon name="github" />
    <span class="hint">{locale === 'uk' ? 'Автор' : 'Author'}</span>
  </a>
)}
<a class="back-top" href="#main" hidden data-top aria-label={text.home}>
  <Icon name="up" />
  <span class="hint">{text.home}</span>
</a>
<script>
  import { currentAircraft, selectAircraft } from '../../lib/aircraft';
  const options = document.querySelectorAll<HTMLButtonElement>(
    '[data-aircraft-option]',
  );
  const picker = document.querySelector<HTMLElement>('#aircraft-options');
  const menu = document.querySelector<HTMLButtonElement>('[data-model-menu]');
  function reveal(open: boolean) {
    menu?.setAttribute('aria-expanded', String(open));
    if (picker) picker.inert = !open;
  }
  menu?.addEventListener('click', () =>
    reveal(menu.getAttribute('aria-expanded') !== 'true'),
  );
  document.addEventListener('pointerdown', (e) => {
    if (!(e.target as Element).closest('.aircraft-picker')) reveal(false);
  });
  menu?.parentElement?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      reveal(false);
      menu.focus();
    }
  });
  menu?.parentElement?.addEventListener('focusout', (e) => {
    if (!menu.parentElement?.contains(e.relatedTarget as Node)) reveal(false);
  });
  function updatePicker() {
    for (const option of options)
      option.disabled = option.dataset.aircraftOption === currentAircraft();
    for (const option of options)
      option.setAttribute(
        'aria-pressed',
        String(option.dataset.aircraftOption === currentAircraft()),
      );
  }
  for (const option of options)
    option.addEventListener('click', () => {
      selectAircraft(
        option.dataset.aircraftOption === 'seven' ? 'seven' : 'whoop',
      );
      reveal(false);
      menu?.focus({ preventScroll: true });
    });
  updatePicker();
  window.addEventListener('aircraft-change', updatePicker);
  const hero = document.querySelector('#hero');
  const library = document.querySelector<HTMLElement>('[data-library]');
  const author = document.querySelector<HTMLElement>('[data-author]');
  const top = document.querySelector<HTMLElement>('[data-top]');
  function update() {
    if (!top) return;
    top.hidden =
      window.scrollY < (hero?.clientHeight ?? window.innerHeight) * 0.75;
    if (hero && library) {
      const pastHero =
        hero.getBoundingClientRect().bottom <= innerHeight * 0.25;
      library.hidden = !pastHero;
      if (author) author.hidden = !pastHero;
    }
  }
  top?.addEventListener('click', (event) => {
    event.preventDefault();
    // Skip intermediate flight poses when returning to the introduction.
    window.scrollTo({ top: 0, behavior: 'instant' });
    document.getElementById('main')?.focus({ preventScroll: true });
  });
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  window.addEventListener('pageshow', update);
  const language = document.querySelector<HTMLAnchorElement>('[data-language]');
  language?.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
      return;
    const section = [...document.querySelectorAll<HTMLElement>('[data-stop]')]
      .reverse()
      .find((el) => el.getBoundingClientRect().top <= innerHeight * 0.25);
    const target = new URL(language.href);
    target.search = location.search;
    target.hash = location.hash;
    if (hero) {
      event.preventDefault();
      window.dispatchEvent(
        new CustomEvent('choose-language', { detail: target.href }),
      );
      return;
    }
    language.href = target.href;
    try {
      sessionStorage.setItem(
        'uptilt:restore',
        JSON.stringify({
          path: target.pathname,
          section: section?.id,
          ratio: section
            ? (scrollY - section.offsetTop) / section.offsetHeight
            : 0,
          y: scrollY,
        }),
      );
    } catch {}
  });
  try {
    const saved = JSON.parse(
      sessionStorage.getItem('uptilt:restore') ?? 'null',
    );
    if (saved?.path === location.pathname) {
      sessionStorage.removeItem('uptilt:restore');
      const section = document.getElementById(saved.section);
      requestAnimationFrame(() =>
        window.scrollTo({
          top: section
            ? section.offsetTop + saved.ratio * section.offsetHeight
            : saved.y,
          behavior: 'instant',
        }),
      );
    }
  } catch {}
</script>
