---
import Icon from '../ui/Icon.vue';
import { pageUrl, type Locale } from '../../lib/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section data-stop id="motion" class="pass">
  <div class="pass-stage">
    <div class="pass-art" aria-hidden="true">
      <div class="gate gate-back"></div>
      <img
        width="950"
        height="643"
        loading="lazy"
        alt=""
        src={import.meta.env.BASE_URL + 'media/front.webp'}
      />
      <div class="gate gate-front"></div>
    </div>
    <a href={pageUrl(locale, 'knowledge/fundamentals')} class="pass-label">
      <span>{locale === 'uk' ? 'Фізика польоту' : 'Flight physics'}</span>
      <Icon name="next" />
    </a>
  </div>
</section>
<script>
  const pass = document.querySelector<HTMLElement>('.pass');
  if (pass) {
    const prefersStatic = matchMedia(
      '(prefers-reduced-motion: reduce), (max-width: 760px)',
    );
    let pending = false;
    function paint() {
      pending = false;
      if (!pass) return;
      const box = pass.getBoundingClientRect();
      if (prefersStatic.matches || box.bottom < 0 || box.top > innerHeight)
        return;
      const progress = Math.max(
        0,
        Math.min(
          1,
          (innerHeight * 0.65 - box.top) / (box.height - innerHeight * 0.35),
        ),
      );
      pass.style.setProperty('--fly-x', 36 - progress * 74 + '%');
      pass.style.setProperty('--fly-y', -19 + progress * 31 + '%');
      pass.style.setProperty('--tilt', -10 + progress * 16 + 'deg');
      pass.classList.toggle('through', progress > 0.56);
    }
    function queue() {
      if (!pending) {
        pending = true;
        requestAnimationFrame(paint);
      }
    }
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    prefersStatic.addEventListener('change', queue);
    paint();
  }
</script>
