---
const floor = [
  [-1, 0.22, 23],
  [-0.86, 0.66, -47],
  [-0.56, 0.81, 31],
  [-0.18, 0.96, -12],
  [0.4, 0.8, 17],
  [0.72, 0.6, -33],
  [0.96, 0.28, 51],
  [-0.94, 0.38, 11],
  [-0.65, 0.73, -23],
  [-0.38, 0.91, 67],
  [0.19, 0.87, -38],
  [0.58, 0.71, 4],
  [0.85, 0.43, -60],
];
// Each particle keeps the same floor origin as it enters its orbit.
type Eddy = [
  region: 'top' | 'rim' | 'centre' | 'bottom',
  x: number,
  y: number,
  size: number,
  floorX: number,
  floorY: number,
  compact?: true,
];
const eddies: Eddy[] = [
  ['top', 79, 11, 21, 69, 88, true],
  ['top', 91, 16, 26, 88, 86],
  ['top', 97, 8, 13, 93, 83, true],
  ['top', 86, 22, 23, 78, 90],
  ['top', 70, 13, 13, 65, 87],
  ['top', 97, 27, 16, 91, 89],
  ['centre', 55, 25, 15, 58, 85, true],
  ['centre', 48, 65, 10, 53, 83],
  ['bottom', 95, 82, 20, 86, 87, true],
  ['bottom', 88, 92, 12, 82, 92],
  ['bottom', 66, 90, 13, 62, 91],
];
const drifting: Eddy[] = [
  ['top', 83, 5, 10, 76, 84],
  ['top', 88, 28, 16, 86, 91, true],
  ['top', 94, 4, 9, 92, 86],
  ['top', 76, 20, 13, 68, 92],
  ['top', 98, 16, 11, 96, 87, true],
  ['centre', 52, 36, 9, 56, 88],
  ['bottom', 76, 94, 11, 73, 90],
  ['bottom', 96, 91, 15, 91, 91],
  ['rim', 99.5, 43, 13, 95, 94, true],
  ['rim', 100, 57, 17, 96, 90],
  ['rim', 98.5, 70, 12, 92, 89, true],
];
const ice = [
  [2, 12, 37],
  [12, 7, 17],
  [17, 19, 62],
  [28, 9, 29],
  [44, 11, 43],
  [51, 7, 19],
  [68, 18, 74],
  [81, 10, 31],
  [91, 12, 46],
];
---

<div class="scatter" hidden aria-hidden="true">
  {floor.map(([x, y, r], i) => (
    <i
      class="season-piece"
      data-shape={i % 3}
      style={`--x:${50 + x * 48}%;--y:${y * 91}%;--r:${r}deg;--flutter:${[29, -24, 15, -34][i % 4]}deg;--lift:${[-21, 17, -34, 12][i % 4]}px;--dx:${x < 0 ? -104 + x * 5 : 79 + x * 8}vw;--dy:${[-13, 15, -7, 19, -17, 12, -9][i % 7]}vh;--delay:${Math.round(Math.hypot(x, y * 0.5) * 210)}ms;--sz:${15 + (i % 5) * 3}px`}
    ></i>
  ))}
</div>
<div class="season-air" aria-hidden="true">
  {[...eddies, ...drifting].map(
    ([region, x, y, width, floorX, floorY, compact], i) => {
      const liftOnRight = region === 'top' || region === 'rim';
      const liftX = liftOnRight ? 101 : region === 'centre' ? 47 : floorX;
      return (
        <div
          class="air-origin"
          data-eddy={region}
          data-compact={compact ? 'true' : undefined}
          data-drifting={i >= eddies.length ? 'true' : undefined}
          style={`left:${x}%;top:${y}%;--exit-x:${(floorX < 75 ? -1 : 1) * (12 + (i % 5) * 2.7)}vw;--exit-y:${[-3, 2, -1, 4][i % 4]}svh;--sx:${floorX - x}vw;
          --sy:${floorY - y}svh;--mobile-sy:${53 + (floorY - 83) / 2 - y}svh;
          --edge:${liftX - x}vw;--rim-y:${region === 'top' ? Math.min(25, y + 8) - y : 0}svh;
          --w:${width}px;--wind:${4.6 + (i % 5) * 0.64}s;
          --beat:${2.3 + (i % 4) * 0.59}s;--offset:${-i * 2.13}s;
          --bank:${i * 37}deg;--lift:${i * 0.065}s`}
        >
          <span class="air-loop">
            <i class="season-piece" data-shape={i % 3}></i>
          </span>
        </div>
      );
    },
  )}
  <svg class="roof-ice" viewBox="0 0 120 84" preserveAspectRatio="none">
    {ice.map(([x, w, h], i) => (
      <g
        transform={`translate(${x} 0)`}
        style={`--grow:${5 + (i % 4) * 1.4}s;--drip:${4 + (i % 3) * 1.3}s;--offset:${-i * 0.89}s`}
      >
        <g class="ice-tip">
          <path
            d={`M0 -2H${w}L${w * 0.75} ${h * 0.43} ${w * 0.46} ${h} ${w * 0.19} ${h * 0.3}Z`}
          />
          <path
            class="ice-facet"
            d={`M${w * 0.58} 0H${w * 0.87}L${w * 0.46} ${h}Z`}
          />
          <circle class="ice-drop" cx={w * 0.46} cy={h} r="1.05" />
        </g>
      </g>
    ))}
  </svg>
</div>
<script>
  const field = document.querySelector<HTMLElement>('.season-air');
  if (field) {
    const story = field.closest<HTMLElement>('[data-story]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let previousTime: number | undefined;
    let depart: number | undefined;
    function paint(now = performance.now()) {
      frame = 0;
      const distance = scrollY / (innerHeight * 0.25);
      const scroll = Math.min(1, Math.max(0, distance));
      const target = scroll * scroll * (3 - 2 * scroll);
      const dt = Math.min(40, now - (previousTime ?? now - 16.7));
      previousTime = now;
      depart ??= target;
      const remaining = target - depart;
      if (reduced.matches || document.hidden || Math.abs(remaining) < 0.002) {
        depart = target;
        previousTime = undefined;
      } else {
        depart += remaining * (1 - Math.exp(-dt / (remaining > 0 ? 115 : 160)));
        schedule();
      }
      story.style.setProperty('--floor-depart', String(depart));
      story.toggleAttribute('data-left-floor', depart === 1);
      field!.toggleAttribute('data-awake', depart < 1 && !document.hidden);
    }
    function schedule() {
      if (!frame) frame = requestAnimationFrame(paint);
    }
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    document.addEventListener('visibilitychange', () => {
      cancelAnimationFrame(frame);
      paint();
    });
    reduced.addEventListener('change', schedule);
    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(frame);
      frame = 0;
      previousTime = undefined;
      field!.removeAttribute('data-awake');
    });
    window.addEventListener('pageshow', schedule);
    paint();
  }
</script>

<style is:global>
  @property --orbit-span {
    syntax: '<number>';
    initial-value: 0;
    inherits: true;
  }
  .season-air {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: clip;
  }
  .season-air,
  .scatter {
    opacity: calc(1 - var(--floor-depart, 0));
  }
  [data-left-floor] :is(.season-air, .scatter) {
    visibility: hidden;
  }
  .scatter i {
    translate: calc(0.2 * var(--dx) * var(--floor-depart, 0))
      calc(0.32 * var(--dy) * var(--floor-depart, 0));
  }
  .air-origin {
    translate: calc(var(--exit-x) * var(--floor-depart, 0))
      calc(var(--exit-y) * var(--floor-depart, 0));
    --wind-x: 3.2vw;
    --wind-y: 2.1svh;
    position: absolute;
    width: var(--w);
    height: var(--w);
    opacity: 0.8;
    transform: translate(var(--sx), var(--sy)) scale(0.84, 0.65);
  }
  .air-origin[data-eddy='top'] {
    --wind-x: 6.3vw;
    --wind-y: 3.8svh;
  }
  .air-origin[data-eddy='rim'] {
    --wind-x: 5.3vw;
    --wind-y: 5.8svh;
  }
  .air-origin[data-drifting] {
    opacity: 0;
  }
  [data-downwash] .air-origin {
    animation: entrain 3.2s cubic-bezier(0.16, 0.62, 0.26, 1) var(--lift) both;
  }
  .air-loop,
  .air-origin i {
    display: block;
    width: 100%;
    height: 100%;
  }
  .air-loop {
    animation: season-eddy var(--wind) ease-in-out var(--offset) infinite;
  }
  .air-origin i {
    animation: tumble var(--beat) ease-in-out var(--offset) infinite;
  }
  .season-piece {
    --skin: linear-gradient(
      52deg,
      #895a38 23%,
      #bb8048 47%,
      #e9bd7c 50%,
      #ab673b 54%,
      #9d673c 83%
    );
    --cut: polygon(
      4% 88%,
      29% 60%,
      8% 58%,
      16% 47%,
      3% 31%,
      32% 37%,
      29% 13%,
      44% 29%,
      50% 1%,
      59% 27%,
      80% 13%,
      76% 36%,
      99% 26%,
      89% 47%,
      97% 55%,
      71% 64%,
      53% 65%,
      31% 68%,
      8% 94%
    );
  }
  [data-season='autumn'] .season-piece[data-shape='1'],
  [data-season='summer'] .season-piece {
    --cut: polygon(
      2% 96%,
      14% 74%,
      13% 62%,
      18% 59%,
      17% 48%,
      24% 48%,
      24% 37%,
      31% 39%,
      34% 27%,
      40% 29%,
      47% 18%,
      52% 21%,
      63% 12%,
      68% 15%,
      82% 9%,
      97% 3%,
      90% 20%,
      89% 29%,
      84% 28%,
      81% 41%,
      75% 40%,
      70% 53%,
      65% 50%,
      57% 63%,
      51% 61%,
      42% 72%,
      36% 69%,
      26% 78%,
      19% 75%,
      5% 98%
    );
  }
  [data-season='autumn'] .season-piece[data-shape='2'] {
    --skin: linear-gradient(
      27deg,
      #724b36,
      #c79055 48%,
      #d9ad74 51%,
      #a06a3c 55%
    );
    --cut: polygon(
      5% 98%,
      18% 78%,
      10% 68%,
      9% 58%,
      17% 53%,
      12% 42%,
      16% 35%,
      26% 38%,
      24% 27%,
      31% 19%,
      42% 23%,
      46% 13%,
      55% 10%,
      63% 15%,
      75% 8%,
      89% 5%,
      91% 15%,
      84% 28%,
      75% 33%,
      80% 39%,
      75% 49%,
      61% 51%,
      64% 58%,
      55% 68%,
      40% 66%,
      39% 74%,
      29% 80%,
      21% 78%,
      8% 99%
    );
  }
  [data-season='summer'] .season-piece {
    --skin: linear-gradient(
      143deg,
      #648153 24%,
      #94aa67 48%,
      #c8cc89 51%,
      #758c51 55%
    );
  }
  [data-season='summer'] .season-piece[data-shape='2'] {
    --cut: polygon(0 95%, 35% 42%, 82% 5%, 100% 1%, 64% 24%, 27% 70%, 5% 99%);
  }
  [data-season='spring'] .season-piece {
    --skin: radial-gradient(ellipse at 60% 24%, #f4d8e2, #dfa7bd 58%, #b77e9b);
    --cut: polygon(
      8% 75%,
      13% 42%,
      30% 15%,
      51% 6%,
      63% 11%,
      70% 4%,
      89% 12%,
      96% 32%,
      88% 56%,
      61% 77%,
      17% 89%
    );
  }
  [data-season='winter'] .season-piece {
    --skin: linear-gradient(42deg, #93b3c5, #eff7fa 54%, #a5becd);
    --cut: polygon(
      6% 51%,
      26% 21%,
      60% 10%,
      85% 29%,
      93% 62%,
      67% 83%,
      34% 85%
    );
  }
  [data-season='winter'] .season-piece[data-shape='1'] {
    --cut: polygon(
      46% 0,
      54% 0,
      55% 36%,
      84% 15%,
      90% 22%,
      62% 46%,
      99% 46%,
      99% 54%,
      62% 55%,
      90% 78%,
      84% 85%,
      55% 64%,
      54% 100%,
      46% 100%,
      45% 64%,
      16% 85%,
      10% 78%,
      38% 54%,
      1% 54%,
      1% 46%,
      38% 46%,
      10% 22%,
      16% 15%,
      45% 36%
    );
  }
  [data-season] :is(.scatter, .air-loop) i.season-piece {
    background: var(--skin);
    clip-path: var(--cut);
    border-radius: 0;
  }
  [data-season='autumn'] .season-piece::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(132deg, transparent 47%, #f2d39b88 49%, transparent 52%),
      repeating-linear-gradient(
        15deg,
        transparent 0 19%,
        #dfb98777 20%,
        transparent 23%
      );
    clip-path: var(--cut);
  }
  @keyframes entrain {
    from {
      --orbit-span: 0;
      transform: translate(var(--sx), var(--sy)) scale(0.84, 0.65);
    }
    37% {
      --orbit-span: 0.18;
      transform: translate(var(--edge), calc(var(--sy) * 0.86)) scale(0.92);
    }
    67% {
      --orbit-span: 0.55;
      transform: translate(var(--edge), var(--rim-y));
    }
    to {
      --orbit-span: 1;
      opacity: 0.78;
      transform: translate(0, 0);
    }
  }
  @keyframes season-eddy {
    0%,
    100% {
      transform: translate(
          calc(-0.45 * var(--wind-x)),
          calc(0.55 * var(--wind-y))
        )
        rotate(-14deg);
    }
    28% {
      transform: translate(var(--wind-x), calc(-0.35 * var(--wind-y)))
        rotate(19deg);
    }
    56% {
      transform: translate(calc(0.3 * var(--wind-x)), calc(-1 * var(--wind-y)))
        rotate(31deg);
    }
    80% {
      transform: translate(calc(-1 * var(--wind-x)), calc(-0.3 * var(--wind-y)))
        rotate(-6deg);
    }
  }
  @supports (offset-path: ellipse(1px 1px at center)) {
    .air-loop {
      offset-path: ellipse(
        calc(var(--wind-x) * var(--orbit-span))
          calc(var(--wind-y) * var(--orbit-span)) at center
      );
      offset-rotate: 0deg;
      animation: orbit var(--wind) linear var(--offset) infinite;
    }
  }
  .air-origin[data-eddy='rim'] .air-loop {
    offset-path: none;
    animation: rim-eddy var(--wind) ease-in-out var(--offset) infinite;
  }
  @keyframes rim-eddy {
    0%,
    100% {
      transform: translate(calc(-1 * var(--wind-x) * var(--orbit-span)), 0);
    }
    25% {
      transform: translate(0, calc(-1 * var(--wind-y) * var(--orbit-span)));
    }
    52% {
      transform: translate(calc(var(--wind-x) * var(--orbit-span)), 0);
    }
    76% {
      transform: translate(0, calc(var(--wind-y) * var(--orbit-span)));
    }
  }
  @keyframes orbit {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }
  .flight-story:not([data-downwash]) :is(.air-loop, .air-loop i) {
    animation-play-state: paused;
  }
  @keyframes tumble {
    0%,
    100% {
      transform: rotate(var(--bank)) rotateY(21deg);
    }
    48% {
      transform: rotate(calc(var(--bank) + 66deg)) rotateY(74deg);
    }
    77% {
      transform: rotate(calc(var(--bank) + 18deg)) rotateX(35deg);
    }
  }
  .roof-ice {
    display: none;
    position: absolute;
    top: 0;
    right: 2%;
    width: clamp(150px, 21vw, 340px);
    height: clamp(43px, 8svh, 88px);
    overflow: visible;
    fill: #a8c9d9;
  }
  [data-season='winter'] .roof-ice {
    display: block;
    opacity: 0.69;
  }
  .ice-tip {
    transform-origin: top;
    animation: ice-grow var(--grow) ease-out both;
  }
  .ice-facet {
    fill: #e3f4fc;
  }
  .ice-drop {
    animation: ice-drip var(--drip) ease-in var(--grow) infinite;
    opacity: 0;
  }
  @keyframes ice-grow {
    from {
      transform: scaleY(0.14);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes ice-drip {
    0%,
    58% {
      opacity: 0;
      transform: translateY(0);
    }
    68% {
      opacity: 0.85;
      transform: translateY(1px);
    }
    95%,
    100% {
      opacity: 0;
      transform: translateY(43px);
    }
  }
  .season-air:not([data-awake])
    :is(.air-origin, .air-loop, .season-piece, .ice-tip, .ice-drop) {
    animation-play-state: paused;
  }
  @media (max-width: 840px), (max-height: 509px) {
    .air-origin {
      --sy: var(--mobile-sy) !important;
    }
    .air-origin:not([data-compact]) {
      display: none;
    }
    .air-origin {
      width: calc(var(--w) * 0.7);
      height: calc(var(--w) * 0.7);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .season-air .air-origin,
    .ice-drop {
      display: none;
    }
    .season-air .ice-tip {
      animation: none;
    }
  }
</style>
