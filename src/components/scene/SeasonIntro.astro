---
const leaves = [
  [-0.83, 0.1, 23],
  [-0.58, 0.46, -47],
  [-0.37, 0.19, 31],
  [0.01, 0.56, -12],
  [0.29, 0.28, 17],
  [0.63, 0.45, -33],
  [0.88, 0.12, 51],
];
---

<div class="scatter" aria-hidden="true">
  {leaves.map(([x, y, r], i) => (
    <i
      style={`--x:${50 + x * 32}%;--y:${12 + y * 46}%;--r:${r}deg;--dx:${x * 176 + (x < 0 ? -18 : 18)}px;--dy:${-27 - (i % 3) * 19}px;--delay:${(i % 3) * 85}ms;--sz:${18 + (i % 4) * 3}px`}
    ></i>
  ))}
</div>
