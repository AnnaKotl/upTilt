---
// Floor coordinates around the footprint; the opening in the middle is deliberate.
const leaves = [
  [-1, 0.22, 23],
  [-0.86, 0.66, -47],
  [-0.56, 0.81, 31],
  [-0.18, 0.96, -12],
  [0.4, 0.8, 17],
  [0.72, 0.6, -33],
  [0.96, 0.28, 51],
];
---

<div class="scatter" hidden aria-hidden="true">
  {leaves.map(([x, y, r], i) => (
    <i
      style={`--x:${50 + x * 48}%;--y:${y * 91}%;--r:${r}deg;--flutter:${[29, -24, 15, -34, 26, -17, 31][i]}deg;--lift:${[-21, 17, -34, 12, -19, 23, -12][i]}px;--dx:${x < 0 ? -41 + x * 9 : 34 + x * 12}vw;--dy:${[-13, 15, -7, 19, -17, 12, -9][i]}vh;--delay:${Math.round(Math.hypot(x, y * 0.5) * 210)}ms;--sz:${17 + (i % 4) * 3}px`}
    ></i>
  ))}
</div>
