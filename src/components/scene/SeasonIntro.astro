---
const leaves = [
  [-0.83, 0.1, 23],
  [-0.58, 0.46, -47],
  [-0.37, 0.19, 31],
  [0.01, 0.56, -12],
  [0.29, 0.28, 17],
  [0.63, 0.45, -33],
  [0.88, 0.12, 51],
];
---

<div class="scatter" hidden aria-hidden="true">
  {leaves.map(([x, y, r], i) => (
    <i
      style={`--x:${50 + x * 32}%;--y:${12 + y * 46}%;--r:${r}deg;--dx:${x < 0 ? -92 + x * 16 : 65 + x * 24}vw;--dy:${[-39, 32, -12, 65, -65, 35, -21][i]}vh;--delay:${(i % 3) * 85}ms;--sz:${18 + (i % 4) * 3}px`}
    ></i>
  ))}
</div>
