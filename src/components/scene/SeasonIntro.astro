---
// Floor coordinates around the footprint; the opening in the middle is deliberate.
const leaves = [
  [-1, 0.22, 23],
  [-0.86, 0.66, -47],
  [-0.56, 0.81, 31],
  [-0.18, 0.96, -12],
  [0.4, 0.8, 17],
  [0.72, 0.6, -33],
  [0.96, 0.28, 51],
];
---

<div class="scatter" hidden aria-hidden="true">
  {leaves.map(([x, y, r], i) => (
    <i
      style={`--x:${50 + x * 48}%;--y:${y * 91}%;--r:${r}deg;--dx:${x < 0 ? -92 + x * 16 : 65 + x * 24}vw;--dy:${[-39, 32, -12, 65, -65, 35, -21][i]}vh;--delay:${Math.round(Math.hypot(x, y * 0.5) * 210)}ms;--sz:${17 + (i % 4) * 3}px`}
    ></i>
  ))}
</div>
