---
import SeasonIntro from './SeasonIntro.astro';
import type { Locale } from '../../lib/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<figure class="specimen" data-specimen>
  <svg class="loading-mark" viewBox="0 0 50 50" aria-hidden="true">
    <path
      fill="none"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-width="2"
      d="M23 25c1-5 10-4 10 2 0 9-15 11-20 2S16 9 26 10c13 1 20 17 13 28"
    />
  </svg>
  <img
    width="1340"
    height="944"
    fetchpriority="high"
    src={import.meta.env.BASE_URL + 'media/alien.webp'}
    alt={
      locale === 'uk'
        ? 'Спортивний квадрокоптер ImpulseRC Alien 5″, вигляд у три чверті'
        : 'ImpulseRC Alien 5″ racing quadcopter, three-quarter view'
    }
  />
  <SeasonIntro />
  <figcaption>
    <span class="caption-rule"></span>
    <span>ImpulseRC Alien 5″</span>
  </figcaption>
</figure>
<script>
  const figure = document.querySelector('[data-specimen]');
  const photo = figure?.querySelector('img');
  if (photo && !photo.complete) {
    figure?.setAttribute('data-loading', '');
    const finish = () => figure?.removeAttribute('data-loading');
    photo.addEventListener('load', finish, { once: true });
    photo.addEventListener('error', finish, { once: true });
    if (photo.complete) finish();
  }
</script>
