---
import LinkArrow from '../ui/LinkArrow.vue';
import { pageUrl, type Locale } from '../../lib/i18n';
import Icon from '../ui/Icon.vue';
import StudyPoster from './StudyPoster.astro';
const { locale } = Astro.props as { locale: Locale };
const i = locale === 'uk' ? 0 : 1;
const searchLabel =
  i === 0 ? 'Пошук конкретної теми' : 'Search for a specific topic';
const routes = [
  {
    path: 'anatomy/frame',
    icon: 'layers',
    name: ['Вперше знайомлюся з FPV', 'New to FPV'],
    detail: [
      'Хочу впізнавати деталі коптера і розуміти їхнє призначення.',
      'I want to recognise the parts of a quad and understand their roles.',
    ],
    target: ['Рама й захист', 'Frame and guards'],
  },
  {
    path: 'fundamentals/axes',
    icon: 'game',
    name: ['Літаю в симуляторі', 'I fly in a simulator'],
    detail: [
      'Хочу пов’язати рух на екрані з фізикою польоту.',
      'I want to connect what I see on screen with flight physics.',
    ],
    target: ['Крен, тангаж і рискання', 'Roll, pitch and yaw'],
  },
  {
    path: 'workbench/boards',
    icon: 'circuit',
    name: ['Вже літаю наживо', 'I fly real quads'],
    detail: [
      'Хочу розібратися в електроніці та з’єднаннях на платі.',
      'I want to understand electronics and the connections on a board.',
    ],
    target: ['Плата, доріжка й контакт', 'Boards, traces and pads'],
  },
] as const;
---

<section
  id="start"
  data-stop
  class="start-routes"
  aria-labelledby="start-heading"
>
  <div class="start-still" aria-hidden="true">
    <StudyPoster name="whoop" />
  </div>
  <div class="start-frame">
    <div class="start-heading">
      <h2 class="section-title" id="start-heading">
        {i === 0 ? 'З чого почати' : 'Where to start'}
      </h2>
      <div class="start-search">
        <button
          class="search-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="start-query"
        >
          <Icon name="search" />
          <span>{searchLabel}</span>
        </button>
        <form
          id="start-query"
          inert
          role="search"
          method="get"
          action={pageUrl(locale, 'knowledge/search')}
        >
          <input
            type="search"
            name="q"
            required
            enterkeyhint="search"
            aria-label={searchLabel}
            autocomplete="off"
          />
          <button type="submit" aria-label={i === 0 ? 'Пошук' : 'Search'}>
            <Icon name="forward" />
          </button>
        </form>
      </div>
    </div>
    <ul>
      {routes.map((route, index) => (
        <li style={`--step:${index}`}>
          <a href={pageUrl(locale, 'knowledge/' + route.path)}>
            <div class="route-title">
              <Icon name={route.icon} />
              <strong>{route.name[i]}</strong>
            </div>
            <p>{route.detail[i]}</p>
            <small>
              <span>{route.target[i]}</span>
              <LinkArrow />
              <span class="route-corner" aria-hidden="true">
                <svg viewBox="0 0 100 36" preserveAspectRatio="none">
                  <path d="M0 35H94L99 30V1" />
                  <path
                    class="pcb-current"
                    pathLength="100"
                    d="M0 35H94L99 30V1"
                  />
                </svg>
              </span>
            </small>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<script>
  const routes = document.querySelector<HTMLElement>('#start')!;
  const search = routes.querySelector<HTMLElement>('.start-search')!;
  const toggle = search.querySelector('button')!;
  const form = search.querySelector('form')!;
  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    form.inert = !open;
    if (open) form.querySelector('input')!.focus({ preventScroll: true });
  }
  toggle.addEventListener('click', () => setOpen(form.inert));
  search.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !form.inert) {
      setOpen(false);
      toggle.focus({ preventScroll: true });
    }
  });
  window.addEventListener('pagehide', () => setOpen(false));
  // Measure the two layouts only when their geometry changes. The canvas
  // supplies one reversible progress value for all three links and the drone.
  const list = routes.querySelector('ul')!;
  const heading = routes.querySelector<HTMLElement>('.start-heading')!;
  const items = Array.from(list.children) as HTMLLIElement[];
  function measureColumn() {
    const gap = Math.max(16, Math.min(window.innerHeight * 0.032, 36));
    const leadGap = Math.max(12, gap - 12);
    let top =
      heading.offsetTop + heading.offsetHeight + leadGap - list.offsetTop;
    for (const item of items) {
      item.style.setProperty('--column-x', -item.offsetLeft + 'px');
      item.style.setProperty('--column-y', top - item.offsetTop + 'px');
      top += item.offsetHeight + gap;
    }
    // The native sticky release carries most of the column out of view.
    // Give taller translations enough clearance for the gate readouts.
    const bottom = list.offsetTop + top - gap;
    routes.style.setProperty(
      '--column-clearance',
      Math.max(0, bottom - window.innerHeight * 0.66) + 'px',
    );
  }
  const sizes = new ResizeObserver(measureColumn);
  for (const element of [routes, heading, list, ...items])
    sizes.observe(element);
  const reveal = new IntersectionObserver(
    ([entry]) => {
      routes.toggleAttribute('data-entered', entry.isIntersecting);
    },
    { rootMargin: '0px 0px -10% 0px' },
  );
  routes.setAttribute('data-reveal', '');
  reveal.observe(routes);
</script>
<style>
  .start-routes {
    position: relative;
    min-height: 100svh;
  }
  .start-frame {
    min-height: 100svh;
    display: grid;
    align-content: start;
    justify-items: start;
    padding: clamp(3rem, 10svh, 8rem) max(6vw, 4rem) clamp(2rem, 6svh, 5rem)
      max(10vw, 4.5rem);
    gap: clamp(3rem, calc(26svh - 5rem), 13rem);
  }
  .start-heading {
    max-width: 72%;
  }
  .start-routes h2 {
    font-size: clamp(1.6rem, 2.9vw, 2.9rem);
  }
  ul {
    position: relative;
    width: 100%;
    justify-self: center;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1rem, 2.7vw, 3rem);
  }
  li {
    margin-top: calc(var(--step) * clamp(2.8rem, 11svh, 8rem));
  }
  li a {
    position: relative;
    display: grid;
    width: 100%;
    max-width: 100%;
    gap: clamp(0.85rem, 2.4svh, 1.6rem);
    padding-block: 0.32rem;
  }
  .route-title {
    display: flex;
    gap: 0.65rem;
    align-items: baseline;
  }
  .route-title :global(svg) {
    flex: none;
    align-self: flex-start;
    width: clamp(1.75rem, 2.25vw, 2.25rem);
    height: auto;
    margin-top: 0.02em;
    color: var(--muted);
  }
  strong {
    font:
      700 clamp(1.22rem, 2vw, 1.68rem)/1.2 Play,
      sans-serif;
  }
  p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }
  small,
  .search-toggle {
    color: var(--accent);
    font: 0.85rem/1.5 var(--font-mono);
  }
  small {
    display: flex;
    gap: 0.45rem;
    align-items: center;
  }
  .route-corner {
    position: relative;
    flex: 0 1 clamp(2rem, 5vw, 5rem);
    align-self: center;
    margin-left: auto;
    pointer-events: none;
    --pulse-period: 4.5s;
    --pulse-delay: calc(var(--step) * -1.3s);
  }
  .route-corner svg {
    position: absolute;
    inset: auto auto -1px 0;
    width: calc(100% + 0.25rem);
    height: clamp(1.6rem, 5svh, 3.2rem);
    overflow: visible;
    fill: none;
    stroke: var(--line);
  }
  .route-corner path {
    vector-effect: non-scaling-stroke;
  }
  .route-corner::after {
    content: '';
    position: absolute;
    width: 0.28rem;
    height: 0.28rem;
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: var(--surface);
    translate: -50% -50%;
  }
  .route-corner .pcb-current {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-entered] .route-corner .pcb-current {
      visibility: visible;
      animation-play-state: running;
    }
  }
  .start-search {
    position: relative;
    width: min(22rem, 100%);
    margin-top: 0.45rem;
    padding-bottom: 48px;
  }
  .search-toggle {
    font-size: clamp(0.97rem, 1.15vw, 1.12rem);
    cursor: pointer;
    display: flex;
    gap: 0.65rem;
    align-items: center;
    min-height: 44px;
    width: fit-content;
  }

  .search-toggle :global(svg),
  form :global(svg) {
    width: 1.35rem;
  }
  form {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    display: flex;
    border: 1px solid color-mix(in srgb, var(--accent) 48%, transparent);
    border-radius: 0.5rem;
    background: var(--surface);
    min-height: 44px;
    opacity: 1;
    transition:
      opacity 0.22s,
      transform 0.22s,
      border-color 0.22s;
  }
  form[inert] {
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
  }
  form:focus-within {
    border-color: var(--accent);
  }
  input:focus-visible {
    outline: none;
  }
  .search-toggle,
  li a :is(strong, small),
  form button {
    transition: color 0.2s ease;
  }
  .search-toggle:is(:hover, :focus-visible),
  li a:is(:hover, :focus-visible) small,
  form button:is(:hover, :focus-visible) {
    color: color-mix(in srgb, var(--accent) 65%, var(--ink));
  }
  li a:is(:hover, :focus-visible) strong {
    color: var(--accent);
  }
  input {
    min-width: 0;
    flex: 1;
    padding: 0.5rem 0.8rem;
  }
  form button {
    width: 44px;
    display: grid;
    place-items: center;
    color: var(--accent);
  }
  .start-still {
    position: absolute;
    width: clamp(4rem, 13vw, 11rem);
    top: 15svh;
    right: 8%;
  }
  :global([data-live]) .start-still {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-reveal] :is(li, .start-search) {
      transition:
        opacity 0.34s,
        translate 0.4s;
    }
    [data-entered] :is(li, .start-search) {
      transition-delay: calc(var(--step) * 95ms);
    }
    [data-reveal]:not([data-entered], :focus-within) :is(li, .start-search) {
      opacity: 0;
      translate: 0 0.7rem;
    }
  }
  @media (min-width: 841px) and (min-height: 380px) and (prefers-reduced-motion: no-preference) {
    li {
      transform: translate(
        calc(var(--column-x, 0px) * var(--column-progress, 0)),
        calc(var(--column-y, 0px) * var(--row-progress, 0))
      );
    }
    .start-routes {
      min-height: 175svh;
    }
    :global([data-live]) .start-routes {
      margin-bottom: 90svh;
    }
    .start-frame {
      position: sticky;
      top: 0;
      translate: 0
        calc(-1 * var(--column-clearance, 0px) * var(--column-exit, 0));
    }
  }
  @media (max-width: 840px) {
    .start-frame {
      padding: 6rem 1.25rem 2rem var(--nav-content-start, 3.6rem);
      gap: 2.25rem;
    }
    .start-heading {
      max-width: 100%;
    }
    .start-routes h2 {
      font-size: clamp(1.25rem, 4.8vw, 2rem);
    }
    ul {
      grid-template-columns: 1fr;
      max-width: 32rem;
      row-gap: 2.25rem;
    }
    li {
      margin-top: 0;
    }

    .start-still {
      top: 0.5rem;
    }
  }
</style>
