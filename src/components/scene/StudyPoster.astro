---
interface Props {
  name: string;
  alt?: string;
  priority?: boolean;
}
const { name, alt = '', priority = false } = Astro.props;
const themed = [
  'kit-whoop',
  'whoop',
  'frame',
  'canopy',
  'camera',
  'antenna',
].includes(name);
const base = import.meta.env.BASE_URL + 'media/study/' + name;
---

<span
  class="study-poster"
  data-aircraft-art={
    name === 'kit-whoop' ? 'kit' : name === 'whoop' || undefined
  }
  role={alt ? 'img' : undefined}
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : true}
>
  <img
    class={themed ? 'night-image' : ''}
    src={base + '-dark.webp'}
    alt=""
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
  {themed && (
    <img
      class="day-image"
      src={base + '-light.webp'}
      alt=""
      loading={priority ? 'eager' : 'lazy'}
      decoding="async"
    />
  )}
</span>
