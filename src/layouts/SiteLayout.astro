---
import '../styles/global.css';
import { seasonPreview } from '../lib/preferences';
import ActionLabel from '../components/ui/ActionLabel.vue';
import Icon from '../components/ui/Icon.vue';
import Header from '../components/layout/Header.astro';
import playCyrillic from '../assets/fonts/play-cyrl.woff2?url';
import playLatin from '../assets/fonts/play-latin.woff2?url';
import { pageUrl, t, locales, type Locale } from '../lib/i18n';
interface Props {
  locale: Locale;
  title: string;
  path?: string;
}
const { locale, title, path = '' } = Astro.props;
const text = t(locale);
const knowledge = path === 'knowledge' || path.startsWith('knowledge/');
---

<!doctype html>
<html
  data-study={path === 'design' || undefined}
  data-knowledge={knowledge || undefined}
  lang={locale}
  data-theme="dark"
  data-season="autumn"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="description" content={text.intro} />
    <title>{title} · upTilt</title>
    {knowledge && (
      <link
        rel="preload"
        href={locale === 'uk' ? playCyrillic : playLatin}
        as="font"
        type="font/woff2"
        crossorigin
      />
    )}
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    {locales.map((lang) => (
      <link
        rel="alternate"
        hreflang={lang}
        href={new URL(pageUrl(lang, path), Astro.site)}
      />
    ))}
    <script is:inline define:vars={{ seasonPreview }}>
      try {
        const month = Number(
          new Intl.DateTimeFormat('en', {
            timeZone: 'Europe/Kyiv',
            month: 'numeric',
          }).format(new Date()),
        );
        document.documentElement.dataset.season = [
          'winter',
          'spring',
          'summer',
          'autumn',
        ][Math.floor((month % 12) / 3)];
        const season =
          new URLSearchParams(location.search).get('season') ?? seasonPreview;
        if (['winter', 'spring', 'summer', 'autumn'].includes(season))
          document.documentElement.dataset.season = season;
        if (sessionStorage.getItem('uptilt:aircraft') === 'seven')
          document.documentElement.dataset.aircraft = 'seven';
        const theme = localStorage.getItem('uptilt:theme');
        const palette = localStorage.getItem('uptilt:palette');
        if (theme === 'light' || theme === 'dark')
          document.documentElement.dataset.theme = theme;
        if (
          document.documentElement.hasAttribute('data-study') &&
          ['signal', 'copper', 'ice'].includes(palette)
        )
          document.documentElement.dataset.palette = palette;
      } catch {
        /* Preferences are optional. */
      }
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-surface font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only fixed top-3 left-3 z-50 bg-panel p-4 focus:not-sr-only"
    >
      {text.skip}
    </a>
    <Header locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!path && (
      <footer class="author-credit">
        <a
          class="edge-tab author-tab"
          data-author
          data-away
          inert
          href="https://github.com/AnnaKotl/upTilt"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" />
          <ActionLabel
            text={locale === 'uk' ? 'Репозиторій' : 'Repository'}
            compact={text.author}
          />
        </a>
      </footer>
    )}

    <script>
      // Let native navigation own history, scroll restoration and modified clicks.
      // Only coalesce repeated activations of the same pending destination.
      let pending = '';
      let activated = 0;
      document.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        const a = (event.target as Element).closest<HTMLAnchorElement>(
          'a[href]',
        );
        if (
          !a ||
          a.hasAttribute('download') ||
          (a.target && a.target !== '_self') ||
          a.origin !== location.origin
        )
          return;
        if (a.pathname === location.pathname && a.search === location.search)
          return;
        const now = performance.now();
        if (pending === a.href && now - activated < 650) {
          event.preventDefault();
          return;
        }
        pending = a.href;
        activated = now;
      });
      window.addEventListener('pageshow', () => {
        pending = '';
      });
    </script>
  </body>
</html>
