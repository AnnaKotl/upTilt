---
import SiteLayout from '../../layouts/SiteLayout.astro';
import BookNav from '../../components/knowledge/BookNav.vue';
import PartsBoard from '../../components/scene/PartsBoard.vue';
import RadioStudy from '../../components/scene/RadioStudy.vue';
import DisplayStudy from '../../components/scene/DisplayStudy.vue';
import SeasonIntro from '../../components/scene/SeasonIntro.astro';
import StudyPoster from '../../components/scene/StudyPoster.astro';
import Icon from '../../components/ui/Icon.vue';
import { locales, t, pageUrl, type Locale } from '../../lib/i18n';
import '../../styles/flight-story.css';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale,
  uk = locale === 'uk';
const kit = [
  { name: uk ? 'Коптер' : 'Quadcopter', asset: 'whoop', topic: 'anatomy' },
  { name: uk ? 'Пульт' : 'Transmitter', asset: 'radio', topic: 'equipment' },
  {
    name: uk ? 'Окуляри або монітор' : 'Goggles or monitor',
    asset: 'goggles',
    topic: 'video',
  },
  { name: uk ? 'Акумулятор' : 'Battery', asset: 'battery', topic: 'power' },
];
---

<SiteLayout locale={locale} title="FPV">
  <div class="flight-story" data-story>
    <div class="scene-stage" aria-hidden="true">
      <div class="stage-light"></div>
      <div class="scene-canvas"></div>
    </div>
    <section data-stop id="hero" class="flight-hero">
      <div class="rest-shadow" aria-hidden="true"></div>
      <div class="hero-machine">
        <StudyPoster
          name="whoop"
          priority
          alt={
            uk
              ? 'Спортивний мікрокоптер із захистом пропелерів'
              : 'Ducted sport micro quadcopter'
          }
        />
      </div>
      <SeasonIntro />
      <div class="hero-type">
        <h1>
          <abbr tabindex="0" aria-label="FPV — First-person view" lang="en">
            {['First-', 'person ', 'view'].map((word, i) => (
              <span class="fpv-word" aria-hidden="true" style={`--i:${i}`}>
                <b data-initial>{word[0].toUpperCase()}</b>
                <span class="fpv-tail">
                  <i>{word.slice(1)}</i>
                </span>
              </span>
            ))}
          </abbr>
        </h1>
        <BookNav client:load locale={locale} />
        <noscript>
          <a href={pageUrl(locale, 'knowledge')}>{t(locale).knowledge}</a>
        </noscript>
      </div>
    </section>
    <section data-stop id="motion" class="gate-chapter">
      <div class="gate-fallback">
        <StudyPoster
          name="gate"
          alt={uk ? 'Гоночне кільце на опорі' : 'Freestanding race gate'}
        />
        <StudyPoster name="whoop" />
      </div>
      <div class="gate-copy">
        <a href={pageUrl(locale, 'knowledge/fundamentals')}>
          <h2>{uk ? 'Фізика польоту' : 'Flight physics'}</h2>
          <Icon name="next" />
        </a>
      </div>
    </section>
    <PartsBoard client:load locale={locale} />
    <section data-stop id="radio" class="radio-chapter">
      <div class="radio-pin">
        <RadioStudy client:load locale={locale}>
          <StudyPoster name="whoop" />
        </RadioStudy>
      </div>
    </section>
  </div>
  <DisplayStudy client:load locale={locale} />
  <section class="equipment-section" data-stop id="kit">
    <h2>{uk ? 'Що взяти для польоту' : 'What goes in the flight bag'}</h2>
    <div class="kit-list">
      {kit.map((item) => (
        <a href={pageUrl(locale, 'knowledge/' + item.topic)}>
          {item.asset === 'goggles' ? (
            <svg
              viewBox="0 0 180 100"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              aria-hidden="true"
            >
              <path d="M31 32q10-12 59-12t59 12l10 33q0 14-15 14h-31l-13-14H80L67 79H36q-15-1-13-14z" />
              <path d="m34 39 47-6-4 25-38 8zm112 0-47-6 4 25 38 8zM23 47l-15 6v13l15 1m135-20 15 6v13l-15 1" />
            </svg>
          ) : (
            <StudyPoster name={item.asset} />
          )}
          <span>{item.name}</span>
        </a>
      ))}
    </div>
    <a class="kit-library" href={pageUrl(locale, 'knowledge')}>
      <Icon name="book" />
      {t(locale).knowledge}
      <Icon name="next" />
    </a>
  </section>
  <script>
    import { currentAircraft } from '../../lib/aircraft';
    const story = document.querySelector<HTMLElement>('[data-story]');
    if (story) {
      const host = story.querySelector<HTMLElement>('.scene-canvas')!;
      const media = matchMedia(
        '(min-width: 841px) and (min-height: 510px) and (prefers-reduced-motion: no-preference)',
      );
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = (
        navigator as Navigator & { connection?: { saveData?: boolean } }
      ).connection?.saveData;
      let cleanup: (() => void) | undefined,
        version = 0;
      async function sync() {
        const turn = ++version;
        cleanup?.();
        cleanup = undefined;
        if (!media.matches || saveData) return;
        try {
          const { mountFlight } = await import('../../graphics/flight');
          if (turn === version && media.matches)
            cleanup = mountFlight(host, story!);
        } catch {
          delete story!.dataset.live;
        }
      }
      const leaves = story.querySelector<HTMLElement>('.scatter')!;
      const storyEl = story;
      const started = performance.now();
      story.dataset.takeoff = String(started);
      story.classList.add('lifting');
      let scattered = false;
      try {
        scattered = sessionStorage.getItem('uptilt:scattered') === 'yes';
      } catch {}
      leaves.hidden = scattered || reduced.matches;
      let timer = 0;
      function advance() {
        clearTimeout(timer);
        if (document.hidden) return;
        const ms = performance.now() - started;
        if (ms < 1500) {
          timer = window.setTimeout(advance, 1500 - ms);
          return;
        }
        if (!leaves.hidden && !scattered) {
          leaves.classList.add('blown');
          scattered = true;
          try {
            sessionStorage.setItem('uptilt:scattered', 'yes');
          } catch {}
        }
        if (ms < 3100) timer = window.setTimeout(advance, 3100 - ms);
        else {
          leaves.hidden = true;
          storyEl.dataset.airborne = 'true';
        }
      }
      function refreshAircraft() {
        for (const art of document.querySelectorAll<HTMLElement>(
          '[data-aircraft-art]',
        )) {
          if (art.hasAttribute('aria-label'))
            art.setAttribute(
              'aria-label',
              currentAircraft() === 'seven'
                ? document.documentElement.lang === 'uk'
                  ? 'Коптер із відкритою карбоновою рамою'
                  : 'Open-frame quadcopter'
                : document.documentElement.lang === 'uk'
                  ? 'Спортивний мікрокоптер із захистом пропелерів'
                  : 'Ducted sport micro quadcopter',
            );
          for (const img of art.querySelectorAll('img')) {
            const file =
              currentAircraft() +
              (img.classList.contains('day-image')
                ? '-light.webp'
                : '-dark.webp');
            if (!img.src.endsWith('/' + file))
              img.src = import.meta.env.BASE_URL + 'media/study/' + file;
          }
        }
      }
      window.addEventListener('aircraft-change', () => {
        refreshAircraft();
        void sync();
      });
      refreshAircraft();
      advance();
      document.addEventListener('visibilitychange', advance);
      media.addEventListener('change', sync);
      void sync();
      let paused = false;
      window.addEventListener('pagehide', () => {
        version++;
        cleanup?.();
        cleanup = undefined;
        paused = true;
        clearTimeout(timer);
      });
      window.addEventListener('pageshow', () => {
        if (paused) {
          paused = false;
          advance();
          void sync();
        }
      });
      const view = document.querySelector<HTMLElement>('.goggle-view');
      if (view) {
        let active = false,
          raf = 0;
        function paint() {
          raf = 0;
          if (active && !reduced.matches) {
            const offset = view!.getBoundingClientRect().top / innerHeight;
            view!.style.setProperty(
              '--tilt',
              Math.max(-1.6, Math.min(1.6, offset * 1.6)) + 'deg',
            );
            view!.style.setProperty(
              '--drift',
              Math.max(-42, Math.min(42, offset * 38)) + 'px',
            );
          }
        }
        const observer = new IntersectionObserver(([e]) => {
          active = e.isIntersecting;
          paint();
        });
        observer.observe(view);
        window.addEventListener(
          'scroll',
          () => {
            if (active && !raf) raf = requestAnimationFrame(paint);
          },
          { passive: true },
        );
      }
    }
  </script>
</SiteLayout>
