---
import { paths } from '../../components/ui/paths';
import SiteLayout from '../../layouts/SiteLayout.astro';
import BookNav from '../../components/knowledge/BookNav.vue';
import PartsBoard from '../../components/scene/PartsBoard.vue';
import RadioStudy from '../../components/scene/RadioStudy.vue';
import DisplayStudy from '../../components/scene/DisplayStudy.vue';
import SeasonIntro from '../../components/scene/SeasonIntro.astro';
import StudyPoster from '../../components/scene/StudyPoster.astro';
import Icon from '../../components/ui/Icon.vue';
import { locales, t, pageUrl, type Locale } from '../../lib/i18n';
import '../../styles/flight-story.css';
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale,
  uk = locale === 'uk';
const kit = [
  { name: uk ? 'Коптер' : 'Quadcopter', asset: 'whoop', topic: 'anatomy' },
  { name: uk ? 'Пульт' : 'Transmitter', asset: 'radio', topic: 'equipment' },
  {
    name: uk ? 'Окуляри або монітор' : 'Goggles or monitor',
    asset: 'goggles',
    topic: 'video',
  },
  { name: uk ? 'Акумулятор' : 'Battery', asset: 'battery', topic: 'power' },
];
---

<SiteLayout locale={locale} title="FPV">
  <div class="flight-story" data-story>
    <div class="boot-screen" aria-hidden="true">
      <svg
        class="boot-circuit"
        viewBox="-500 -300 1000 600"
        preserveAspectRatio="none"
        fill="none"
        stroke="url(#boot-silver)"
      >
        <defs>
          <linearGradient
            id="boot-silver"
            gradientUnits="userSpaceOnUse"
            x1="0"
            x2="490"
            y1="0"
            y2="0"
          >
            <stop offset="0" stop-color="currentColor" />
            <stop class="boot-glint" offset="0.36" stop-color="currentColor" />
            <stop class="boot-glint" offset="0.71" stop-color="currentColor" />
            <stop offset="1" stop-color="currentColor" />
          </linearGradient>
        </defs>
        {[1, -1].map((side) => (
          <g transform={`scale(${side} 1)`}>
            {[
              'M24 -6 H96 L154 -64 H316 L370 -118 H484',
              'M24 0 H99 L155 -56 H297 L360 7 H462',
              'M24 7 H85 L142 64 H232 L294 126 H477',
              'M15 -19 L69 -73 V-143 L144 -218 H270 L332 -280',
              'M9 19 V74 L82 147 H202 L282 227 H407',
              'M4 -18 V-119 L58 -173 V-286',
            ].map((d) => (
              <path
                class="boot-trace"
                d={d}
                pathLength="1"
                vector-effect="non-scaling-stroke"
              />
            ))}
          </g>
        ))}
      </svg>
      <svg
        class="boot-mark"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
      >
        <path d={paths.quad} stroke-width="1.3" />
      </svg>
    </div>
    <script is:inline>
      try {
        if (!sessionStorage.getItem('uptilt:boot') && !location.hash) {
          const root = document.documentElement;
          root.dataset.bootStart = String(performance.now());
          root.dataset.boot = 'pending';
          sessionStorage.setItem('uptilt:boot', '1');
          setTimeout(() => {
            delete root.dataset.boot;
          }, 3000);
        }
      } catch {}
    </script>
    <div class="scene-stage" aria-hidden="true">
      <div class="stage-light"></div>
      <div class="bench-mat"></div>
      <div class="scene-canvas"></div>
    </div>
    <section data-stop id="hero" class="flight-hero">
      <div class="hero-shot">
        <div class="rest-shadow" aria-hidden="true"></div>
        <div class="hero-machine">
          <StudyPoster
            name="whoop"
            priority
            alt={
              uk
                ? 'Спортивний мікрокоптер із захистом пропелерів'
                : 'Ducted sport micro quadcopter'
            }
          />
        </div>
        <SeasonIntro />
        <div class="hero-type">
          <h1>
            <abbr aria-label="FPV — First-person view" lang="en">
              {['First', 'Person', 'View'].map((word, i) => (
                <span
                  class="fpv-word"
                  aria-hidden="true"
                  style={`--i:${i};--letters:${word.length - 1}`}
                >
                  <b data-initial>{word[0].toUpperCase()}</b>
                  <span class="fpv-tail">
                    <i>{word.slice(1)}</i>
                  </span>
                </span>
              ))}
            </abbr>
          </h1>
          <BookNav client:load locale={locale} />
          <noscript>
            <a href={pageUrl(locale, 'knowledge')}>{t(locale).knowledge}</a>
          </noscript>
        </div>
      </div>
    </section>
    <section data-stop id="motion" class="gate-chapter">
      <div class="gate-fallback">
        <StudyPoster
          name="gate"
          alt={uk ? 'Гоночне кільце на опорі' : 'Freestanding race gate'}
        />
        <StudyPoster name="whoop" />
      </div>
      <div class="gate-copy">
        <a href={pageUrl(locale, 'knowledge/fundamentals')}>
          <h2>
            <span>{uk ? 'Фізика' : 'Flight'}</span>
            <span>{uk ? 'польоту' : 'physics'}</span>
          </h2>
          <Icon name="forward" />
        </a>
      </div>
    </section>
    <PartsBoard client:load locale={locale} />
    <section data-stop id="radio" class="radio-chapter">
      <div class="radio-pin">
        <RadioStudy client:load locale={locale}>
          <StudyPoster name="whoop" />
        </RadioStudy>
      </div>
    </section>
  </div>
  <DisplayStudy client:load locale={locale} />
  <section class="equipment-section" data-stop id="kit">
    <h2>{uk ? 'Що потрібно для польоту' : 'What you need to fly'}</h2>
    <div class="kit-list">
      {kit.map((item) => (
        <a href={pageUrl(locale, 'knowledge/' + item.topic)}>
          <StudyPoster name={'kit-' + item.asset} />
          <span>{item.name}</span>
        </a>
      ))}
    </div>
  </section>
  <section data-stop id="before-flight" class="before-flight">
    <div class="preflight-title">
      <Icon name="quad" />
      <h2>{uk ? 'Перед польотом' : 'Before you fly'}</h2>
    </div>
    <a
      class="preflight-book"
      href={pageUrl(locale, 'knowledge')}
      aria-label={t(locale).knowledge}
    >
      <Icon name="book" />
    </a>
    <p>
      {uk
        ? 'Розберися, що тримає коптер у повітрі, а перші кола пройди в симуляторі.'
        : 'Find out what keeps a quad in the air, then fly your first laps in a simulator.'}
    </p>
    <ol>
      {[
        ['fundamentals', 'Фізика польоту', 'Flight physics'],
        ['anatomy', 'Будова коптера', 'Quad anatomy'],
        ['equipment', 'Пульт і спорядження', 'Radio and flight gear'],
        [
          'simulators',
          'Перші кола в симуляторі',
          'First laps in the simulator',
        ],
        ['workbench', 'Знайомство з пайкою', 'Soldering basics'],
      ].map(([slug, ua, en], i) => (
        <li style={`--i:${i}`}>
          <a href={pageUrl(locale, 'knowledge/' + slug)}>
            <i aria-hidden="true"></i>
            <span>{uk ? ua : en}</span>
            <Icon name="forward" />
          </a>
        </li>
      ))}
    </ol>
    <a
      class="media-credits"
      href={import.meta.env.BASE_URL + 'media/credits.txt'}
    >
      {uk ? 'Авторство зображень' : 'Image credits'}
    </a>
  </section>
  <script>
    import {
      initHomeLanguage,
      initPresentation,
    } from '../../lib/home-controls';
    import { currentAircraft } from '../../lib/aircraft';
    const story = document.querySelector<HTMLElement>('[data-story]');
    if (story) {
      const host = story.querySelector<HTMLElement>('.scene-canvas')!;
      const media = matchMedia(
        '(min-width: 841px) and (min-height: 510px) and (prefers-reduced-motion: no-preference)',
      );
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = (
        navigator as Navigator & { connection?: { saveData?: boolean } }
      ).connection?.saveData;
      let cleanup: (() => void) | undefined,
        version = 0;
      async function sync() {
        const turn = ++version;
        cleanup?.();
        cleanup = undefined;
        heroShot.append(leaves);
        if (!media.matches || saveData) return;
        try {
          const { mountFlight } = await import('../../graphics/flight');
          if (turn === version && media.matches) {
            cleanup = mountFlight(host, story!);
            host.before(leaves);
          }
        } catch {
          delete story!.dataset.live;
        }
      }
      const leaves = story.querySelector<HTMLElement>('.scatter')!;
      const storyEl = story;
      const heroShot = story.querySelector<HTMLElement>('.hero-shot')!;
      let started = performance.now();
      story.dataset.takeoff = String(started);
      story.dataset.awaiting = 'true';
      let scattered = false;
      try {
        scattered = sessionStorage.getItem('uptilt:scattered') === 'yes';
      } catch {}
      leaves.hidden = scattered || reduced.matches;
      let timer = 0,
        waiting = true;
      let releaseTimer = 0;
      function ready() {
        if (!waiting) return;
        const root = document.documentElement;
        const remaining =
          Number(root.dataset.bootStart ?? 0) + 1000 - performance.now();
        if (root.dataset.boot === 'pending' && remaining > 0) {
          clearTimeout(releaseTimer);
          releaseTimer = window.setTimeout(ready, remaining);
          return;
        }
        waiting = false;
        if (document.documentElement.dataset.boot === 'pending') {
          document.documentElement.dataset.boot = 'ready';
          setTimeout(() => {
            delete document.documentElement.dataset.boot;
          }, 180);
        }
        delete storyEl.dataset.awaiting;
        restart(false);
      }
      storyEl.addEventListener('scene-painted', ready, { once: true });
      function advance() {
        clearTimeout(timer);
        if (document.hidden || waiting) return;
        const ms = performance.now() - started;
        if (ms < 1820) {
          timer = window.setTimeout(advance, 1820 - ms);
          return;
        }
        if (!leaves.hidden && !scattered) {
          leaves.classList.add('blown');
          scattered = true;
          try {
            sessionStorage.setItem('uptilt:scattered', 'yes');
          } catch {}
        }
        if (ms < 4250) timer = window.setTimeout(advance, 4250 - ms);
        else {
          leaves.hidden = true;
          storyEl.dataset.airborne = 'true';
        }
      }
      function refreshAircraft() {
        for (const art of document.querySelectorAll<HTMLElement>(
          '[data-aircraft-art]',
        )) {
          if (art.hasAttribute('aria-label'))
            art.setAttribute(
              'aria-label',
              currentAircraft() === 'seven'
                ? document.documentElement.lang === 'uk'
                  ? 'Коптер із відкритою карбоновою рамою'
                  : 'Open-frame quadcopter'
                : document.documentElement.lang === 'uk'
                  ? 'Спортивний мікрокоптер із захистом пропелерів'
                  : 'Ducted sport micro quadcopter',
            );
          for (const img of art.querySelectorAll('img')) {
            const file =
              (art.dataset.aircraftArt === 'kit' ? 'kit-' : '') +
              currentAircraft() +
              (img.classList.contains('day-image')
                ? '-light.webp'
                : '-dark.webp');
            if (!img.src.endsWith('/' + file))
              img.src = import.meta.env.BASE_URL + 'media/study/' + file;
          }
        }
      }
      function restart(scatterAgain: boolean) {
        waiting = false;
        delete storyEl.dataset.awaiting;
        started = performance.now();
        storyEl.dataset.takeoff = String(started);
        delete storyEl.dataset.airborne;
        if (scatterAgain) scattered = false;
        leaves.classList.remove('blown');
        storyEl.classList.remove('lifting');
        void storyEl.offsetWidth;
        leaves.hidden = scattered || reduced.matches;
        storyEl.classList.add('lifting');
        storyEl.dispatchEvent(new Event('restart-intro'));
        advance();
      }
      initHomeLanguage();
      initPresentation();
      window.addEventListener('page-language', refreshAircraft);
      window.addEventListener('tour-restart', () => restart(true));
      window.addEventListener('aircraft-change', () => {
        restart(false);
        window.dispatchEvent(new Event('scene-reset'));
        refreshAircraft();
        void sync();
      });
      refreshAircraft();
      const poster = heroShot.querySelector<HTMLImageElement>(
        document.documentElement.dataset.theme === 'light'
          ? '.day-image'
          : '.night-image',
      )!;
      const deadline = window.setTimeout(ready, 3000);
      void poster.decode().then(ready, () => {});
      storyEl.addEventListener('restart-intro', () => clearTimeout(deadline), {
        once: true,
      });
      document.addEventListener('visibilitychange', advance);
      media.addEventListener('change', sync);
      void sync();
      let paused = false;
      window.addEventListener('pagehide', () => {
        version++;
        cleanup?.();
        cleanup = undefined;
        paused = true;
        clearTimeout(timer);
      });
      window.addEventListener('pageshow', () => {
        if (paused) {
          paused = false;
          advance();
          void sync();
        }
      });
    }
  </script>
</SiteLayout>
