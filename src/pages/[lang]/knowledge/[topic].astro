---
import LinkArrow from '../../../components/ui/LinkArrow.vue';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import KnowledgeCrumbs from '../../../components/knowledge/KnowledgeCrumbs.astro';
import LessonLinks from '../../../components/knowledge/LessonLinks.astro';
import RadioDiagram from '../../../components/knowledge/RadioDiagram.astro';
import MediaGallery from '../../../components/knowledge/MediaGallery.astro';

import { firmwareMedia, inavNote } from '../../../data/firmware-media';
import { lessons, topicIntroductions } from '../../../data/lessons';
import { simulatorSections } from '../../../data/simulator-sections';
import { topics } from '../../../data/topics';
import { locales, type Locale } from '../../../lib/i18n';
import '../../../styles/knowledge.css';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    topics.map((topic) => ({
      params: { lang, topic: topic.id },
      props: { topic },
    })),
  );
}
const locale = Astro.params.lang as Locale;
const { topic } = Astro.props;
const path = 'knowledge/' + topic.id;
const uk = locale === 'uk';
---

<SiteLayout locale={locale} title={topic.title[locale]} path={path}>
  <article class="reading-page">
    <KnowledgeCrumbs
      locale={locale}
      trail={[{ title: topic.title[locale], path }]}
    />
    <h1>{topic.title[locale]}</h1>
    <div class="reading-note">
      <p class="knowledge-lead">{topicIntroductions[topic.id][uk ? 0 : 1]}</p>
    </div>
    <section class="reading-note">
      <h2 class="section-title">{topic.question[locale]}</h2>
      <p>{topic.note[locale]}</p>
    </section>
    <section class="reading-note">
      <h2 class="section-title">{uk ? 'Теми' : 'Topics'}</h2>
      <LessonLinks locale={locale} path={path} items={lessons[topic.id]} />
    </section>
    {topic.id === 'simulators' && (
      <section class="reading-note" id="practice">
        <h2 class="section-title">
          {uk ? 'Вибір і практика' : 'Selection and practice'}
        </h2>
        <LessonLinks locale={locale} path={path} items={simulatorSections} />
      </section>
    )}
    {topic.id === 'firmware' && (
      <>
        <MediaGallery
          locale={locale}
          title={uk ? 'Інтерфейси' : 'Interfaces'}
          items={firmwareMedia}
        />
        <section class="reading-note" id={inavNote.id}>
          <h2 class="section-title">{inavNote.title[locale]}</h2>
          <p>{inavNote.text[locale]}</p>
          <a
            class="inline-link"
            href={inavNote.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            INAV Configurator <LinkArrow />
          </a>
        </section>
      </>
    )}
    {topic.id === 'radio' && <RadioDiagram locale={locale} />}
    <aside class="reference-line">
      <a href={topic.source.url}>
        {uk ? 'Джерело розділу' : 'Section reference'} · {topic.source.label}{' '}
        <LinkArrow />
      </a>
    </aside>
  </article>
</SiteLayout>
