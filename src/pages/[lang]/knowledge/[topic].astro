---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import KnowledgeCrumbs from '../../../components/knowledge/KnowledgeCrumbs.astro';
import LessonLinks from '../../../components/knowledge/LessonLinks.astro';
import RadioDiagram from '../../../components/knowledge/RadioDiagram.astro';
import MediaGallery from '../../../components/knowledge/MediaGallery.astro';
import SimulatorExercises from '../../../components/knowledge/SimulatorExercises.astro';
import { firmwareMedia } from '../../../data/firmware-media';
import { lessons, topicIntroductions } from '../../../data/lessons';
import { simulators } from '../../../data/simulators';
import { topics } from '../../../data/topics';
import { locales, type Locale } from '../../../lib/i18n';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    topics.map((topic) => ({
      params: { lang, topic: topic.id },
      props: { topic },
    })),
  );
}
const locale = Astro.params.lang as Locale;
const { topic } = Astro.props;
const path = 'knowledge/' + topic.id;
const uk = locale === 'uk';
---

<SiteLayout locale={locale} title={topic.title[locale]} path={path}>
  <article class="reading-page">
    <KnowledgeCrumbs
      locale={locale}
      trail={[{ title: topic.title[locale], path }]}
    />
    <h1>{topic.title[locale]}</h1>
    <div class="reading-note">
      <p>{topicIntroductions[topic.id][uk ? 0 : 1]}</p>
    </div>
    {topic.id === 'radio' && <RadioDiagram locale={locale} />}
    <section class="reading-note">
      <h2>{topic.question[locale]}</h2>
      <p>{topic.note[locale]}</p>
    </section>
    <section class="reading-note">
      <h2>{uk ? 'Теми' : 'Topics'}</h2>
      <LessonLinks locale={locale} path={path} items={lessons[topic.id]} />
      {topic.id === 'simulators' && (
        <a class="inline-link" href="#practice">
          {uk ? 'До вправ' : 'Go to exercises'} ↓
        </a>
      )}
    </section>
    {topic.id === 'firmware' && (
      <>
        <MediaGallery
          locale={locale}
          title={uk ? 'Інтерфейси' : 'Interfaces'}
          items={firmwareMedia}
        />
        <section class="reading-note">
          <h2>
            {uk ? 'Якщо на платі встановлено INAV' : 'If the board runs INAV'}
          </h2>
          <p>
            {uk
              ? 'INAV має власний настільний Configurator для сумісних плат і версій. За назвою плати та версією прошивки звіряй, який застосунок потрібен саме тобі.'
              : 'INAV has its own desktop Configurator for compatible boards and firmware versions. Check the board name and firmware version to find the right application.'}
          </p>
          <a
            class="inline-link"
            href="https://github.com/iNavFlight/inav-configurator/releases"
            target="_blank"
            rel="noopener noreferrer"
          >
            INAV Configurator ↗
          </a>
        </section>
      </>
    )}
    {topic.id === 'simulators' && (
      <>
        <MediaGallery
          locale={locale}
          title={uk ? 'Симулятори для практики' : 'Simulators for practice'}
          items={simulators}
        />
        <SimulatorExercises locale={locale} />
      </>
    )}
  </article>
</SiteLayout>
